# HubScope 本地环境配置示例
# 复制此文件为 .env.local 并根据你的环境修改
# .env.local 文件会被 Git 忽略，不会提交到仓库

# =============================================================================
# 数据目录配置
# =============================================================================

# 数据目录（Docker 容器挂载的宿主机目录）
# 默认: $HOME/data
# 说明: 用于存放数据库文件和备份
# 注意: 需要 sudo 权限来创建和修改此目录的权限
# 示例: /opt/hubscope/data 或 /var/lib/hubscope
DATA_DIR=$HOME/data

# 备份目录（数据库备份文件存放位置）
# 默认: $DATA_DIR/hubscope-backups
# 说明: 部署脚本会自动创建此目录，并按时间戳保存备份
# 示例: /mnt/backups/hubscope
# BACKUP_DIR=

# =============================================================================
# Docker 配置（可选）
# =============================================================================

# Docker 镜像仓库（如果推送到私有仓库）
# 默认: 空（仅本地构建）
# 示例: registry.example.com/hubscope
# DOCKER_REGISTRY=

# =============================================================================
# 调试配置
# =============================================================================

# 启用调试输出（0=关闭, 1=开启）
# 默认: 0
# 说明: 开启后会输出更详细的日志信息
# DEBUG=1

# =============================================================================
# 其他环境变量（根据需要添加）
# =============================================================================

# 示例: 自定义端口（默认 8080）
# PORT=8080

# 示例: 自定义主机 IP（默认 192.168.1.101）
# HOST_IP=192.168.1.101
