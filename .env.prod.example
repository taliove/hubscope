# HubScope 生产环境配置示例
# 复制此文件为 .env.prod 并根据你的生产环境修改
# .env.prod 文件会被 Git 忽略,不会提交到仓库(公开仓库零敏感值纪律,spec 0008)
#
# 使用方:.claude/skills/deploy-prod/scripts/deploy.sh(source 本文件后 ssh 驱动远程)
# 纪律:实值只进 .env.prod;本示例文件只放占位符,禁止把实值提交进来

# =============================================================================
# 生产机连接(必填,无默认值)
# =============================================================================

# 生产机地址(IP 或主机名)
# 示例: 203.0.113.10
PROD_HOST=

# SSH 端口
# 示例: 22
PROD_SSH_PORT=22

# SSH 用户(需有 docker 权限,推荐 root 或已加入 docker 组的用户)
# 示例: root
PROD_SSH_USER=root

# =============================================================================
# 站点与 Caddy
# =============================================================================

# 对外域名(Caddy 站点块 + 自动 HTTPS;DNS 需已指向 PROD_HOST,80/443 需放行)
# 示例: status.example.com
PROD_DOMAIN=

# Caddy 配置文件路径(生产机上)
# 默认: /etc/caddy/Caddyfile
# PROD_CADDYFILE=/etc/caddy/Caddyfile

# =============================================================================
# 数据与目录(生产机上)
# =============================================================================

# 应用数据目录(容器 /data 的 bind mount 源,唯一数据落点)
# 默认: /data/hubscope
# PROD_DATA_DIR=/data/hubscope

# 备份目录
# 默认: /data/hubscope-backups
# PROD_BACKUP_DIR=/data/hubscope-backups

# 运维脚本安装目录(scripts/ops 同步目标)
# 默认: /opt/hubscope/bin
# PROD_OPS_DIR=/opt/hubscope/bin

# 应用端口(容器只绑 127.0.0.1,公网由 Caddy 终结)
# 默认: 8080
# PROD_PORT=8080

# =============================================================================
# 初始化(deploy.sh init)
# =============================================================================

# Docker CE yum 源(国内默认阿里云;腾讯云内网可换 mirrors.cloud.tencent.com/docker-ce)
# 默认: https://mirrors.aliyun.com/docker-ce
# PROD_DOCKER_YUM_MIRROR=https://mirrors.aliyun.com/docker-ce

# Caddy 版本(init 时开发机下载缓存后 scp 到生产机)
# 默认: latest(caddyserver.com/api/download 最新稳定版)
# 示例: 2.11.4(固定版本时从 GitHub Releases 下载)
# PROD_CADDY_VERSION=latest

# =============================================================================
# 调试
# =============================================================================

# 启用调试输出(0=关闭, 1=开启)
# 默认: 0
# DEBUG=1
